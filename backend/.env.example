# ======================================================================
# MEDD Maharashtra 2.0 — environment configuration TEMPLATE
# Copy to backend/.env and replace every "change_me" value.
# Never commit backend/.env. Never put these values in frontend files.
# ======================================================================
MEDD_ENV=development

# --- PostgreSQL --------------------------------------------------------
# Superuser connection, used ONLY by scripts/setup_database.py to create roles + database.
PG_SUPERUSER_URL=postgresql://postgres:change_me@localhost:5432/postgres
# Application role (read/write: ingestion, auth, audit)
MEDD_APP_PASSWORD=change_me_app_password
DATABASE_URL=postgresql+psycopg://medd_app:change_me_app_password@localhost:5432/medd
# Read-only role (dashboards, analytics, Decision Support AI)
MEDD_READONLY_PASSWORD=change_me_readonly_password
DATABASE_URL_READONLY=postgresql+psycopg://medd_readonly:change_me_readonly_password@localhost:5432/medd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000
CHAT_STATEMENT_TIMEOUT_MS=5000

# --- Security ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRY_MINUTES=480
AUTH_ENABLED=true
# Comma-separated origins allowed to call the API from another host (leave empty when served by the backend itself)
CORS_ORIGINS=
# Set true when deployed behind HTTPS (adds HSTS + secure redirect)
FORCE_HTTPS=false
# Initial administrator created by setup_database.py (change password after first login)
MEDD_ADMIN_USERNAME=admin
MEDD_ADMIN_PASSWORD=change_me_admin_password

# --- Ingestion ---------------------------------------------------------
WATCHER_ENABLED=true
WATCHER_SETTLE_SECONDS=3
WATCHER_POLL_SECONDS=30
MAX_UPLOAD_MB=100
CACHE_TTL_SECONDS=600

# --- Optional: LLM phrasing for Decision Support AI ---------------------
# Numbers ALWAYS come from the deterministic SQL engine; the LLM only rephrases. Leave disabled if unsure.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

MEDD_FY_LABEL=FY 2025-26
